{
  "name": "propertyiq",
  "private": true,
  "license": "MIT",
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/sitemap.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src vite.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "lint": "eslint src --max-warnings 0",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "^9.0.0",
    "recharts": "^3.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
